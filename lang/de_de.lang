# Shell-Funktionen gesperrt (Issue #18)
ffmpeg_shell_disabled = Auf diesem Server sind die PHP-Funktionen zum Ausführen von Programmen (shell_exec, exec, proc_open) gesperrt. FFmpeg kann daher nicht genutzt werden; Videos lassen sich im Medienpool trotzdem normal bearbeiten. Bitten Sie Ihren Hoster, eine dieser Funktionen freizugeben.

# Automatische Optimierung (Cronjob)
ffmpeg_auto_legend = Automatische Optimierung
ffmpeg_auto_intro = Neue Videos werden automatisch auf eine Standardgröße heruntergerechnet und für das Web aufbereitet (H.264, Fast Start: startet sofort im Browser). Das Original wird ersetzt – Dateiname, Titel und alle Metadaten bleiben erhalten. Ersetzt wird nur, wenn die Datei dadurch kleiner wird oder das Original in Browsern nicht zuverlässig abspielt; fehlt nur Fast Start, wird die Datei verlustfrei umsortiert. Videos werden nie vergrößert. Immer nur ein Video gleichzeitig: direkt nach dem Hochladen und danach alle 10 Minuten per Cronjob.
ffmpeg_auto_enabled = Videos automatisch optimieren
ffmpeg_auto_preset = Standardgröße
ffmpeg_auto_preset_1080p = Full HD – höchstens 1920 × 1080 (empfohlen)
ffmpeg_auto_preset_720p = HD – höchstens 1280 × 720 (kleinere Dateien)
ffmpeg_auto_preset_480p = Klein – höchstens 854 × 480 (z. B. Hintergrundvideos)
ffmpeg_auto_preset_help = Gilt für Quer- und Hochformat (Hochformat Full HD: 1080 × 1920). Kleinere Videos werden nur umgewandelt, wenn Format oder Datenrate nicht webtauglich sind.
ffmpeg_auto_scope = Welche Videos?
ffmpeg_auto_scope_new = Nur Videos, die ab dem Einschalten hochgeladen werden
ffmpeg_auto_scope_all = Auch alle vorhandenen Videos im Medienpool
ffmpeg_auto_status_running = Läuft gerade: {0} ({1} %)
ffmpeg_auto_status_pending = Noch zu prüfen: {0} Video(s)
ffmpeg_auto_cronjob_link = Cronjob „FFmpeg: Videos automatisch optimieren“ ansehen
ffmpeg_auto_no_cronjob_addon = Das AddOn „Cronjob“ ist nicht installiert: Videos werden nur direkt nach dem Hochladen optimiert. Alternativ den Konsolenbefehl per System-Cronjob ausführen.
ffmpeg_auto_console_hint = Konsole: „php redaxo/bin/console ffmpeg:optimize --wait“ arbeitet alle wartenden Videos nacheinander ab.
ffmpeg_auto_cronjob_name = FFmpeg: Videos automatisch optimieren
ffmpeg_auto_cronjob_description = Rechnet neue Videos im Medienpool auf die Standardgröße herunter und arbeitet vorgemerkte Aufträge ab (Einstellungen in Medienpool → Video-Tools → Einstellungen).
config_always = Immer enthalten: H.264 mit AAC-Ton (spielt in allen Browsern), browsertaugliches Farbformat, Fast Start (das Video startet sofort). Videos werden nie vergrößert, Hochformat bleibt Hochformat.
ffmpeg_option_size = Größe
ffmpeg_option_size_help = Höchstens diese Größe – bei Hochformat entsprechend (Full HD: höchstens 1080 × 1920). Kleinere Videos bleiben, wie sie sind.
ffmpeg_option_quality = Qualität
ffmpeg_option_quality_help = „Ausgewogen“ ist von der Vorlage kaum zu unterscheiden. „Hoch“ für Archiv und Nahaufnahmen, „Kleine Datei“ für lange Videos und Hintergrundvideos.
ffmpeg_option_audio = Ton
ffmpeg_option_audio_help = „Lautstärke angleichen“ bringt leise und laute Videos auf ein einheitliches Niveau (−16 LUFS). „Entfernen“ z. B. für Hintergrundvideos – spart Platz.
ffmpeg_size_original = Originalgröße
ffmpeg_size_1080p = Full HD – höchstens 1920 × 1080
ffmpeg_size_720p = HD – höchstens 1280 × 720
ffmpeg_size_480p = Klein – höchstens 854 × 480
ffmpeg_size_360p = Sehr klein – höchstens 640 × 360
ffmpeg_quality_high = Hoch (größere Datei)
ffmpeg_quality_balanced = Ausgewogen (empfohlen)
